{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "pkgs": ["nodejs-18_x"],
      "phases": {
        "install": {
          "cmd": "npm install"
        },
        "build": {
          "cmd": "true"
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}