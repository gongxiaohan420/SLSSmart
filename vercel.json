{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "dist/$1"
    }
  ],
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/database.db",
      "includeFiles": "backend/templates/**"
    }
  }
}